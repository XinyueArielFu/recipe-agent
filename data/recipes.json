  "ingredients": [
    {"name_zh": "奶油奶酪", "name_en": "cream cheese", "amount": 220, "unit": "g"},
    {"name_zh": "糖", "name_en": "sugar", "amount": 65, "unit": "g"},
    {"name_zh": "鸡蛋", "name_en": "egg", "amount": 2, "unit": "个"},
    {"name_zh": "淡奶油", "name_en": "whipping cream", "amount": 120, "unit": "g"},
    {"name_zh": "玉米淀粉", "name_en": "corn starch", "amount": 10, "unit": "g"},
