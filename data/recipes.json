  "recipe_id": "R1000",
  "source": "mom",
  "name_zh": "四寸戚风蛋糕",
  "name_en": "4-inch chiffon cake",
  "tags_zh": ["甜品", "蛋糕", "点心", "甜", "碳水"],
  "tags_en": ["dessert", "cake", "snack", "sweet", "carbohydrate"],
  "difficulty": "median",
  "servings": 1,
  "is_standalone_dish": true,
  "components": [],
  "cooking_stages": [
    {"stage_order": 1, "tool_zh": "烤箱", "tool_en": "ove", "temperature_F": 310, "heat_level_zh": "预热", "heat_level_en": "pre heat", "duration_minutes": null, "notes_zh": "把烤箱预热至310华氏度"},
    {"stage_order": 2, "tool_zh": "烤箱", "tool_en": "oven", "temperature_F": 310, "heat_level_zh": "烘烤", "heat_level_en": "bake", "duration_minutes": 45, "notes_zh": "面糊放入烤箱310华氏度45分钟"}
  ],
  "ingredients": [
    {"name_zh": "蛋白", "name_en": "egg white", "amount": 4, "unit": "个"},
    {"name_zh": "蛋黄", "name_en": "egg yolk", "amount": 4, "unit": "个"},
    {"name_zh": "低筋面粉", "name_en": "cake flour", "amount": 40, "unit": "g"},
    {"name_zh": "糖", "name_en": "sugar", "amount": 40, "unit": "g"},
    {"name_zh": "油", "name_en": "oil", "amount": 40, "unit": "g"},
    {"name_zh": "牛奶", "name_en": "milk", "amount": 40, "unit": "g"},
    {"name_zh": "柠檬汁", "name_en": "lemon juice", "amount": 4, "unit": "g"}
  ],
  "steps_description": "准备两个干净无油无水的碗分别用来打蛋黄和蛋清. 1.先将油, 牛奶搅打至融合乳化在空盆中 \n2.加入低筋面粉混合均匀 \n3.加入蛋黄搅拌均匀, 用干净打蛋器打发 \n4.从冷藏拿出蛋清加入柠檬汁打发至粗泡, 分三次加入糖打发至硬性发泡 \n5.将蛋白分三次加入蛋黄糊中, 用刮刀翻拌均匀 \n6.倒入戚风模具中, 放入预热好的烤箱中烘烤45分钟 \n7.出炉后倒扣放凉, 脱模即可",
  "notes": "1. 提前将分离好的蛋清放在容器里放到冰箱保持低温, 更好打发. 2. 80g蔓越莓干, 糖量减半, 就是蔓越莓蛋糕啦"
}, 
