  ],
  "ingredients": [
    {"name_zh": "椰青水", "name_en": "coconut water", "amount": 330, "unit": "g"},
    {"name_zh": "椰浆", "name_en": "coconut milk", "amount": 400, "unit": "ml"},
    {"name_zh": "牛奶", "name_en": "milk", "amount": 260, "unit": "g"},
    {"name_zh": "糖", "name_en": "sugar", "amount": 40, "unit": "g"},
